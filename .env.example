# API base URL for all backend calls (src/lib/api.ts)
VITE_API_BASE="https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/dev"

# Required for Cognito username/password sign-in (src/lib/cognito.ts)
VITE_USER_POOL_ID=""
VITE_USER_POOL_CLIENT_ID=""

# Required for Hosted UI / social sign-in — enables Google & Apple flows
VITE_USER_POOL_DOMAIN=""
# Browser route that receives the OAuth authorization code (defaults to /auth/callback)
VITE_OAUTH_CALLBACK_PATH="/auth/callback"

# Toggle social providers on (only effective when VITE_USER_POOL_DOMAIN is set)
VITE_SOCIAL_GOOGLE_ENABLED="false"
VITE_SOCIAL_APPLE_ENABLED="false"